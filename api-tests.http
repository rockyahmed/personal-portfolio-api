@baseUrl = http://localhost:5281
@contentType = application/json

### 1. Login as Admin
# Default seeded Admin: admin@example.com / Admin@123456
# @name adminLogin
POST {{baseUrl}}/api/v1/auth/login
Content-Type: {{contentType}}

{
  "identifier": "admin@example.com",
  "password": "Admin@123456"
}

### Store Token from Admin Login
@adminToken = {{adminLogin.response.body.data.accessToken}}
@refreshToken = {{adminLogin.response.body.data.refreshToken}}

### 2. Login as Standard Demo User
POST {{baseUrl}}/api/v1/auth/login
Content-Type: {{contentType}}

{
  "identifier": "johndoe",
  "password": "User@123456"
}

### 3. Register a New User
# @name registerUser
POST {{baseUrl}}/api/v1/auth/register
Content-Type: {{contentType}}

{
  "username": "sarahconnor",
  "email": "sarah.connor@example.com",
  "firstName": "Sarah",
  "lastName": "Connor",
  "password": "Password@123",
  "phoneNumber": "+1234567890"
}

### 4. Get Current User Profile (Me)
GET {{baseUrl}}/api/v1/auth/me
Authorization: Bearer {{adminToken}}

### 5. Refresh Access Token
POST {{baseUrl}}/api/v1/auth/refresh-token
Content-Type: {{contentType}}

{
  "accessToken": "{{adminToken}}",
  "refreshToken": "{{refreshToken}}"
}

### 6. Get All Users (Paginated, Search & Filter) - Admin/Manager only
GET {{baseUrl}}/api/v1/users?pageNumber=1&pageSize=10&searchTerm=&role=Admin&status=Active&sortBy=CreatedAt&sortDescending=true
Authorization: Bearer {{adminToken}}

### 7. Search Users by Keyword
GET {{baseUrl}}/api/v1/users?searchTerm=john
Authorization: Bearer {{adminToken}}

### 8. Create User by Admin
# @name createUser
POST {{baseUrl}}/api/v1/users
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "username": "alexsmith",
  "email": "alex.smith@example.com",
  "firstName": "Alex",
  "lastName": "Smith",
  "password": "SecurePassword@123",
  "phoneNumber": "+1555987654",
  "role": "Manager",
  "status": "Active"
}

### Store Created User ID
@newUserId = {{createUser.response.body.data.id}}

### 9. Get User by ID
GET {{baseUrl}}/api/v1/users/{{newUserId}}
Authorization: Bearer {{adminToken}}

### 10. Update User Profile
PUT {{baseUrl}}/api/v1/users/{{newUserId}}
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "firstName": "Alexander",
  "lastName": "Smith",
  "phoneNumber": "+1555000111"
}

### 11. Update User Status (Suspend account)
PATCH {{baseUrl}}/api/v1/users/{{newUserId}}/status
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "status": "Suspended"
}

### 12. Update User Role (Promote to Admin)
PATCH {{baseUrl}}/api/v1/users/{{newUserId}}/role
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "role": "Admin"
}

### 13. Soft Delete User
DELETE {{baseUrl}}/api/v1/users/{{newUserId}}
Authorization: Bearer {{adminToken}}

### 14. Revoke Active Session (Logout)
POST {{baseUrl}}/api/v1/auth/revoke-token
Authorization: Bearer {{adminToken}}


# ==========================================================
# 🌟 PORTFOLIO PROJECTS API
# ==========================================================

### 15. Get All Portfolio Projects (Public)
GET {{baseUrl}}/api/v1/projects?pageNumber=1&pageSize=10

### 16. Get Featured Portfolio Projects (Public)
GET {{baseUrl}}/api/v1/projects/featured

### 17. Search Projects by Tag (e.g., React, .NET Core)
GET {{baseUrl}}/api/v1/projects?tag=React

### 18. Search Projects by Keyword (Title / Description / Tag)
GET {{baseUrl}}/api/v1/projects?searchTerm=E-Commerce

### 19. Create Portfolio Project (Admin / Manager)
# Fields: image, link, title, tag, description, githubUrl, isFeatured, displayOrder
# @name createProject
POST {{baseUrl}}/api/v1/projects
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "title": "Crypto Portfolio Tracker",
  "description": "Real-time cryptocurrency analytics dashboard with live market prices, interactive portfolio profit & loss tracking, and price alert notifications.",
  "imageUrl": "https://images.unsplash.com/photo-1621416894569-0f39ed31d247?w=800",
  "link": "https://crypto-tracker.example.com",
  "tags": "React, TypeScript, .NET Core, WebSockets, TailwindCSS",
  "githubUrl": "https://github.com/example/crypto-tracker",
  "isFeatured": true,
  "displayOrder": 1
}

### Store Created Project ID
@newProjectId = {{createProject.response.body.data.id}}

### 20. Get Portfolio Project by ID (Public)
GET {{baseUrl}}/api/v1/projects/{{newProjectId}}

### 21. Update Portfolio Project (Admin / Manager)
PUT {{baseUrl}}/api/v1/projects/{{newProjectId}}
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "title": "Crypto Portfolio Tracker Pro",
  "description": "Enhanced multi-wallet cryptocurrency portfolio tracker with automated transaction syncing and tax reporting.",
  "imageUrl": "https://images.unsplash.com/photo-1621416894569-0f39ed31d247?w=800",
  "link": "https://crypto-pro.example.com",
  "tags": "React, TypeScript, .NET 10, WebSockets, PostgreSQL",
  "githubUrl": "https://github.com/example/crypto-tracker",
  "isFeatured": true,
  "displayOrder": 1
}

### 22. Delete Portfolio Project (Admin)
DELETE {{baseUrl}}/api/v1/projects/{{newProjectId}}
Authorization: Bearer {{adminToken}}
